<Project>

  <PropertyGroup>
    <OpenSilverVersion Condition=" '$(OpenSilverVersion)' == '' ">3.4.0-preview-2026-11-20-102406-941451b4</OpenSilverVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OpenSilver" Version="$(OpenSilverVersion)" Condition=" '$(UseOpenSilver)' == 'true' "/>
  </ItemGroup>

</Project>